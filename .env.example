# =============================================================================
# PIXEL — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit .env with real credentials or API keys to version control.
# =============================================================================

# Server & Gateway Runtime
PIXEL_ENV=development
PIXEL_HOST=127.0.0.1
PIXEL_PORT=8000
PIXEL_LOG_LEVEL=INFO
PIXEL_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Storage & Persistence
# Local Standalone (SQLite) or Server (PostgreSQL + pgvector)
PIXEL_DATABASE_URL=sqlite+aiosqlite:///./data/pixel.db
# PIXEL_DATABASE_URL=postgresql+asyncpg://pixel:pixel_password@localhost:5432/pixel
PIXEL_REDIS_URL=redis://localhost:6379/0

# Voice Pipeline (Perception & Synthesis)
PIXEL_VAD_MODE=silero
PIXEL_STT_PROVIDER=faster-whisper
PIXEL_TTS_PROVIDER=kokoro
PIXEL_DEFAULT_LANGUAGE=hi-Latn

# External LLM / Cloud Voice Fallback (Optional)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GROQ_API_KEY=your-groq-api-key
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=pixel-runtime
